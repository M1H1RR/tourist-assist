# ==============================================================================
# Tourist Assist - Production & Local Environment Configuration
# A QR-Based Tourist Information and Essential Facility System
# for Nashik Kumbh Mela 2027 and Nashik Tourism
# ==============================================================================

# Application Port & Node Environment
PORT=3000
NODE_ENV=production

# Server JWT Authentication Secret (Minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Supabase Integration (Optional - App falls back to verified municipal dataset if not set)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
